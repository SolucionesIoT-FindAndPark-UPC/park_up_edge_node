# ESP32 Cam Stream Test Requests

# 1. Start processing your ESP32 cam stream for automatic plate recognition
POST http://localhost:8000/edge/camera/stream/start-processing
Content-Type: application/json

{
    "cameraId": "esp32_cam_01",
    "streamUrl": "http://192.168.18.85/capture",
    "processInterval": 3
}

###

# 2. Check status of active streams
GET http://localhost:8000/edge/camera/stream/status

###

# 3. Start circulation monitoring with custom ESP32 IP
POST http://localhost:8000/edge/parking/circulation/esp32/parking_entrance
Content-Type: application/x-www-form-urlencoded

stream_url=http://192.168.18.85/capture

###

# 4. Test with default ESP32 URL (update IP in code)
GET http://localhost:8000/edge/camera/stream/test/test_camera

###

# 5. Stop processing a specific camera
POST http://localhost:8000/edge/camera/stream/stop-processing
Content-Type: application/json

{
    "cameraId": "esp32_cam_01"
}

###

# 6. Stop circulation monitoring
DELETE http://localhost:8000/edge/parking/circulation/esp32/parking_entrance

###

# 7. Test original circulation endpoint with file upload (for comparison)
POST http://localhost:8000/edge/parking/circulation
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="file"; filename="test.jpg"
Content-Type: image/jpeg

< ./assets/carplate.jpeg
--boundary--
