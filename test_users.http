# User Synchronization API Tests
# Compatible with Java backend UserResource(Long id, String username, List<String> roles)

# 1. Test MySQL connection
GET http://localhost:8000/edge/users/test/mysql

###

# 2. Sync users from MySQL database  
POST http://localhost:8000/edge/users/sync
Content-Type: application/json

{
    "force_sync": true
}

###

# 3. Get cached users (full data for internal use)
GET http://localhost:8000/edge/users/cached

###

# 4. Get user by ID (Java UserResource format: id, username, roles)
GET http://localhost:8000/edge/users/1

###

# 5. Get user by email (Java UserResource format: id, username, roles)
GET http://localhost:8000/edge/users/email/admin@parkup.com

###

# 6. Sync users without forcing (uses cached if available)
POST http://localhost:8000/edge/users/sync
Content-Type: application/json

{
    "force_sync": false
}
